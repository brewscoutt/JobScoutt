# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Optional — enables semantic ranking of matches. Free tier at https://dashboard.voyageai.com/
VOYAGE_API_KEY=

# Optional — only needed if you set EMAIL_TO in job_hunt.py.
# For Gmail: smtp.gmail.com, port 587, an App Password (not your regular
# password) from https://myaccount.google.com/apppasswords (requires 2FA).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
